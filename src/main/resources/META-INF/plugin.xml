<idea-plugin>
    <id>dev.javakky.phpstan-type-documentation</id>
    <name>PHPStan Type Documentation</name>
    <vendor email="dev@javakky.dev">javakky</vendor>
    <description><![CDATA[
        Shows Quick Documentation and Go to Declaration for PHPStan type aliases in PHPDoc.
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.jetbrains.php</depends>

    <extensions defaultExtensionNs="com.intellij">
        <fileBasedIndex implementation="dev.javakky.phpstantypedoc.index.PhpStanTypeAliasIndex"/>
        <gotoDeclarationHandler implementation="dev.javakky.phpstantypedoc.PhpStanTypeGotoDeclarationHandler"/>
        <lang.inspectionSuppressor language="PHP" implementationClass="dev.javakky.phpstantypedoc.inspection.PhpStanTypeAliasInspectionSuppressor"/>
        <platform.backend.documentation.linkHandler implementation="dev.javakky.phpstantypedoc.doc.PhpStanTypeDocumentationLinkHandler"/>
        <platform.backend.documentation.targetProvider implementation="dev.javakky.phpstantypedoc.doc.PhpStanTypeDocumentationTargetProvider"/>
        <!-- リンクの行き先となるクラスの documentation に、そのクラスの型エイリアスを載せる -->
        <platform.backend.documentation.psiTargetProvider order="first" implementation="dev.javakky.phpstantypedoc.doc.PhpStanClassDocumentationTargetProvider"/>
        <!-- platform の互換実装より先に評価させる (order=first がないと PHP 標準の表示が採られる) -->
        <platform.backend.documentation.inlineDocumentationProvider order="first" implementation="dev.javakky.phpstantypedoc.doc.PhpStanInlineDocumentationProvider"/>
    </extensions>

    <extensions defaultExtensionNs="com.jetbrains.php">
        <arrayShapesProvider implementation="dev.javakky.phpstantypedoc.shape.PhpStanImportedArrayShapeProvider"/>
    </extensions>
</idea-plugin>
